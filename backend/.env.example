# ==============================================================================
# Mrittika AI (মৃত্তিকা এআই) - Backend Environment Configuration Example
# Copy this file to `backend/.env` for local development.
# Do NOT commit `.env` containing sensitive credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security
# ------------------------------------------------------------------------------
# Set DEBUG to False in production. Never run with DEBUG=True on a public server.
DEBUG=True

# Cryptographic signing secret. For production, generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-mrittika-dev-secret-key-replace-in-production-2026

# Comma-separated hostnames/IPs this Django site can serve.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]

# Comma-separated origins allowed to make cross-origin HTTP requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173

# Comma-separated origins trusted for CSRF-protected POST requests.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# If POSTGRES_DB is left blank or unset, Django defaults to SQLite (db.sqlite3).
# For Docker / PostgreSQL production deployments, set these variables:
POSTGRES_DB=
POSTGRES_USER=mrittika_user
POSTGRES_PASSWORD=mrittika_secure_password_replace_in_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. JWT & Authentication
# ------------------------------------------------------------------------------
# Access token validity: 15 minutes. Refresh token validity: 7 days.
# Refresh tokens are securely stored in httpOnly, SameSite=Lax cookies.
AUTH_COOKIE_NAME=mrittika_refresh_token
AUTH_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 4. Hugging Face & Machine Learning Models
# ------------------------------------------------------------------------------
# Model repository allow-listed on Hugging Face Hub:
HF_REPO_ID=ripro805/mrittika-ai
HF_REVISION=main

# Optional Hugging Face access token for gated models / higher rate limits.
HF_TOKEN=

# Directory where .pkl model artifacts are stored.
MODEL_DIR=ml_models

# ------------------------------------------------------------------------------
# 5. LLM Providers (Groq & Google Gemini Free Tiers)
# ------------------------------------------------------------------------------
# Priority failover order (comma-separated): groq, gemini (or mock for testing)
LLM_PROVIDER_ORDER=groq,gemini

# Primary Free-Tier Provider: Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM_SOFT=25
GROQ_RPD_SOFT=13000
GROQ_TIMEOUT_SECONDS=15.0

# Secondary Free-Tier Provider: Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_RPM_SOFT=12
GEMINI_RPD_SOFT=1400
GEMINI_TIMEOUT_SECONDS=15.0

# Circuit Breaker settings: 5 consecutive failures opens circuit for 60 seconds
CIRCUIT_BREAKER_MAX_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=60.0

# ------------------------------------------------------------------------------
# 6. RAG (Retrieval-Augmented Generation) & ChromaDB
# ------------------------------------------------------------------------------
# Embedding provider: local (sentence-transformers)
EMBEDDING_PROVIDER=local

# Embedding model name:
# Default: intfloat/multilingual-e5-large
# Low-resource alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 or kazalbrur/bangla-embed-e5-small
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Local ChromaDB persistent storage directory
CHROMA_DIR=chroma_db

# Minimum cosine distance threshold for RAG retrieval (0.0 to 1.0)
# Above this distance, system immediately triggers Upazila Officer fallback with NO LLM call.
RAG_MIN_SCORE=0.85

# Context retrieval chunk count and token budget
RAG_TOP_K=4
MAX_PROMPT_TOKENS=3000
MAX_OUTPUT_TOKENS=600

# ------------------------------------------------------------------------------
# 7. Throttling & Global Quota Guard
# ------------------------------------------------------------------------------
# Global daily cap on chat messages across all users to protect free quotas
CHAT_GLOBAL_RPD=5000

# Per-IP and Per-User rate limits (DRF throttle rates)
THROTTLE_ANON=100/min
THROTTLE_USER=300/min
THROTTLE_CHAT_ANON=10/min
THROTTLE_CHAT_USER=30/min

# ------------------------------------------------------------------------------
# 8. External Weather API
# ------------------------------------------------------------------------------
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# 9. Logging & Diagnostics
# ------------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
