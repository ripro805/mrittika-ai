# Mrittika AI Environment Configuration Example

# ==========================================
# Backend Configuration
# ==========================================
DEBUG=False
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Leave blank for dev SQLite, or provide PostgreSQL connection string)
# DATABASE_URL=postgres://mrittika_user:mrittika_password@localhost:5432/mrittika_db

# Hugging Face Model Integration
HF_REPO_ID=ripro805/mrittika-ai
HF_REVISION=main
HF_TOKEN=

# RAG & Assistant
LLM_PROVIDER=mock
# Options: mock | gemini | anthropic | openai_compatible
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_API_BASE=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Weather Integration
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_BASE_URL=/api/v1
