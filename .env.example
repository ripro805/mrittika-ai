# ==============================================================================
# Mrittika AI (মৃত্তিকা এআই) - Full Stack Docker Compose Environment Example
# Copy this file to `.env` in the project root for Docker Compose or local runs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django & Security Settings
# ------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=django-insecure-prod-placeholder-replace-with-openssl-rand-hex-32
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (Docker Service)
# ------------------------------------------------------------------------------
POSTGRES_DB=mrittika_db
POSTGRES_USER=mrittika_user
POSTGRES_PASSWORD=mrittika_secure_password_replace_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://mrittika_user:mrittika_secure_password_replace_in_prod@postgres:5432/mrittika_db

# ------------------------------------------------------------------------------
# 3. Machine Learning & Hugging Face Hub
# ------------------------------------------------------------------------------
HF_REPO_ID=ripro805/mrittika-ai
HF_REVISION=main
HF_TOKEN=
MODEL_DIR=/app/ml_models

# ------------------------------------------------------------------------------
# 4. LLM Providers (Free Tier APIs)
# ------------------------------------------------------------------------------
LLM_PROVIDER_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM_SOFT=25
GROQ_RPD_SOFT=13000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_RPM_SOFT=12
GEMINI_RPD_SOFT=1400

MAX_PROMPT_TOKENS=3000
MAX_OUTPUT_TOKENS=600

# ------------------------------------------------------------------------------
# 5. RAG & Vector Knowledge Base
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
CHROMA_DIR=/app/chroma_db
RAG_MIN_SCORE=0.85

# ------------------------------------------------------------------------------
# 6. Global Caps & Weather API
# ------------------------------------------------------------------------------
CHAT_GLOBAL_RPD=5000
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# 7. Frontend Client Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
