# ==============================================================================
# Mrittika AI (মৃত্তিকা এআই) - Frontend Environment Configuration Example
# Copy this file to `frontend/.env` for local development.
# Vite exposes variables prefixed with `VITE_` to the client-side bundle.
# ==============================================================================

# Backend API Base URL
# In local dev with Vite proxy, use '/api/v1' or 'http://localhost:8000/api/v1'
VITE_API_BASE_URL=/api/v1

# App Version & Title
VITE_APP_NAME="Mrittika AI"
VITE_APP_VERSION="1.0.0"

# Feature Flags
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_SAMPLE_BADGES=true
